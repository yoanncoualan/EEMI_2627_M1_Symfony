{% extends 'base.html.twig' %}
 
{% block title %}Hello CategoryController!{% endblock %}
 
{% block body %}
    <h1>{{'category.title'|trans}}</h1>
    <p>{{ 'category.nbr'|trans({ '%nb%':categories|length }) }}</p>
 
    {% for category in categories %}
        <h2>
            <a href="{{ path('app_categorie_show', {'id': category.id}) }}">
                {{category.title}}
            </a>
        </h2>
        <p>{{category.description}}</p>

        <form action="{{path('app_category_delete', {id: category.id})}}" method="POST">
            <input type="hidden" name="csrf" value="{{ csrf_token('delete' ~ category.id) }}">
            <input type="submit" value="Delete">
        </form>
        <hr/>
    {% else %}
        <p>Empty set</p>
    {% endfor %}

    <h2>Create a category</h2>
    {{ form(form) }}
{% endblock %}