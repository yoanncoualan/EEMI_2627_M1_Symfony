{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}
    <h1>Product index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Content</th>
                <th>CreatedDate</th>
                <th>Image</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.title }}</td>
                <td>{{ product.content }}</td>
                <td>{{ product.createdDate ? product.createdDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ product.image }}</td>
                <td>
                    <a href="{{ path('app_product_test_show', {'id': product.id}) }}">show</a>
                    <a href="{{ path('app_product_test_edit', {'id': product.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_product_test_new') }}">Create new</a>
{% endblock %}
